<?xml version="1.0" encoding="utf-8"?>
<!--
    item_tajwid_rule.xml
    Item pour le RecyclerView des observations de Tajwid.

    Layout :
      [Icône severity]  [Nom AR / Nom FR]  [Description]
                        [Texte fautif → Texte correct]

    Fond coloré selon severity :
      severity=0 (OK)      → vert clair  #d4edda
      severity=1 (Warning) → orange clair #fff3cd
      severity=2 (Error)   → rouge clair  #f8d7da

    minSdk 14 – support-v7:28 – RTL
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:background="#E8F5E9"
    android:layoutDirection="rtl"
    android:gravity="center_vertical">

    <!-- Icône de sévérité (✅ / ⚠️ / ❌) -->
    <TextView
        android:id="@+id/tv_severity_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✅"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginStart="4dp" />

    <!-- Colonne texte -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <!-- Nom de la règle : arabe + français -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_rule_name_ar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إظهار حلقي"
                android:textColor="#1a1a1a"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textDirection="rtl"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_rule_name_fr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Izhar Halqi"
                android:textColor="#333333"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Description courte -->
        <TextView
            android:id="@+id/tv_rule_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="النون الساكنة أو التنوين قبل حرف حلقي تُظهر بدون غنة"
            android:textColor="#444444"
            android:textSize="12sp"
            android:textDirection="rtl"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Texte fautif → Texte correct (visible uniquement si différents) -->
        <LinearLayout
            android:id="@+id/layout_correction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_wrong_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#c0392b"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textDirection="rtl"
                android:background="#ffe0e0"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ← "
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_correct_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1a7a1a"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textDirection="rtl"
                android:background="#e0f0e0"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
