<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    >

    <TextView
        android:id="@+id/txtPageNotFound"
        android:text="PageLoading"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:background="#FFF4CB"
    />

    <quran.hb.com.quran.PageScrollView
        android:id="@+id/page_scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        >

        <quran.hb.com.quran.ZoomableImageView
            android:id="@+id/imgDisplay"
            android:background="#FFF4CB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            />

    </quran.hb.com.quran.PageScrollView>

    <View
        android:id="@+id/hlView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66FFC107"
        android:visibility="gone" />

</RelativeLayout>
