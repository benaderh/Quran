<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:layoutDirection="rtl">

    <!-- En-tete -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#000000"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x2190;"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&#x0625;&#x0645;&#x0644;&#x0627;&#x0621;"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRiwayaImla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x062D;&#x0641;&#x0635;"
            android:textColor="#FFD700"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <!-- Centre : info aya -->
    <LinearLayout
        android:id="@+id/llCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvAyaNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x0627;&#x0644;&#x0622;&#x064A;&#x0629; &#x0627;&#x0644;&#x0623;&#x0648;&#x0644;&#x0649;"
            android:textColor="#FFD700"
            android:textSize="32sp"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSoraName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x0633;&#x0648;&#x0631;&#x0629; &#x0627;&#x0644;&#x0641;&#x0627;&#x062A;&#x062D;&#x0629;"
            android:textColor="#aaaaaa"
            android:textSize="20sp"
            android:gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/tvAyaRevealed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:gravity="center"
            android:visibility="gone"
            android:lineSpacingMultiplier="1.5"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#555555"
            android:textSize="16sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bas : controles -->
    <LinearLayout
        android:id="@+id/llBottomImla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResultImla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevImla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x25C0; &#x0627;&#x0644;&#x0633;&#x0627;&#x0628;&#x0642;&#x0629;"
                android:textColor="#FFFFFF"
                android:background="#333333"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnRecordImla"
                android:layout_width="130dp"
                android:layout_height="56dp"
                android:text="&#x1F3D9;&#xFE0F; &#x0627;&#x0628;&#x062F;&#x0623;"
                android:textColor="#FFFFFF"
                android:background="#227e08"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnNextImla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x0627;&#x0644;&#x062A;&#x0627;&#x0644;&#x064A;&#x0629; &#x25B6;"
                android:textColor="#FFFFFF"
                android:background="#333333"
                android:layout_margin="4dp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>