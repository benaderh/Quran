<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="rtl">

    <!-- Page image plein ecran -->
    <ImageView
        android:id="@+id/ivPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Overlay dore semi-transparent pour highlight aya -->
    <View
        android:id="@+id/ayaHighlight"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#44FFD700"
        android:visibility="gone" />

    <!-- Barre basse -->
    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E6000000"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Barre de mode -->
        <LinearLayout
            android:id="@+id/llModeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeTilawa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="&#x1F4D6; &#x062A;&#x0644;&#x0627;&#x0648;&#x0629;"
                android:textColor="#FFFFFF"
                android:background="#227e08"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnModeImla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="&#x270D;&#xFE0F; &#x0625;&#x0645;&#x0644;&#x0627;&#x0621;"
                android:textColor="#FFFFFF"
                android:background="#1d0606"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRiwaya"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="&#x062D;&#x0641;&#x0635;"
                android:textColor="#FFD700"
                android:background="@android:color/transparent"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Zone mots de l'aya -->
        <HorizontalScrollView
            android:id="@+id/hsvWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llWords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />

        </HorizontalScrollView>

        <!-- Controles navigation aya -->
        <LinearLayout
            android:id="@+id/llControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevAya"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&#x25C0;"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvAyaInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="&#x0627;&#x0644;&#x0641;&#x0627;&#x062A;&#x062D;&#x0629; : 1"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnNextAya"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&#x25B6;"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Bouton enregistrement -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:text="&#x1F3D9;&#xFE0F;"
                android:textSize="28sp"
                android:background="#227e08"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Feedback -->
        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:padding="4dp" />

    </LinearLayout>

</RelativeLayout>