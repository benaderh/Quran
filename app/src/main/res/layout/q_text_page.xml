<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- Barre supérieure : titre + nav pages -->
    <LinearLayout
        android:id="@+id/qtp_topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#16213E"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/qtp_btnPrevPage"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="◄"
            android:textColor="#E2B96F"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/qtp_tvTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#E2B96F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="صفحة 1"/>

        <Button
            android:id="@+id/qtp_btnNextPage"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="►"
            android:textColor="#E2B96F"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- WebView pour le texte du Coran avec zoom -->
    <WebView
        android:id="@+id/qtp_webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/qtp_topBar"
        android:layout_above="@id/qtp_bottomBar"/>

    <!-- Barre inférieure : zoom + fermer -->
    <LinearLayout
        android:id="@+id/qtp_bottomBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#16213E"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/qtp_btnZoomOut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="أ-"
            android:textColor="#E2B96F"
            android:textSize="18sp"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/qtp_btnZoomIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="أ+"
            android:textColor="#E2B96F"
            android:textSize="18sp"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/qtp_btnClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✕"
            android:textColor="#FF6B6B"
            android:textSize="18sp"
            android:background="@android:color/transparent"/>

        <!-- Indicateur riwaya -->
        <TextView
            android:id="@+id/qtp_tvRiwaya"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#9B8C6A"
            android:textSize="13sp"
            android:text="حفص"/>
    </LinearLayout>

</RelativeLayout>
