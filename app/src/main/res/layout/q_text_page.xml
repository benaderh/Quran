<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0D9A8">

    <!-- Barre supérieure : titre + navigation pages -->
    <LinearLayout
        android:id="@+id/qtp_topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#8B4513"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/qtp_btnPrevPage"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="◄"
            android:textColor="#F9EDD2"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/qtp_tvTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#F9EDD2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="صفحة ١"/>

        <Button
            android:id="@+id/qtp_btnNextPage"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="►"
            android:textColor="#F9EDD2"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- WebView : affiche la page Mushaf (fond parchemin inclus dans le HTML) -->
    <WebView
        android:id="@+id/qtp_webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/qtp_topBar"
        android:layout_above="@id/qtp_bottomBar"
        android:background="#FEF7E4"/>

    <!-- Barre inférieure : zoom + riwaya + fermer -->
    <LinearLayout
        android:id="@+id/qtp_bottomBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#8B4513"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/qtp_btnZoomOut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="أ-"
            android:textColor="#F9EDD2"
            android:textSize="17sp"
            android:background="@android:color/transparent"/>

        <Button
            android:id="@+id/qtp_btnZoomIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="أ+"
            android:textColor="#F9EDD2"
            android:textSize="17sp"
            android:background="@android:color/transparent"/>

        <!-- Indicateur riwaya (Hafs / Warsh) -->
        <TextView
            android:id="@+id/qtp_tvRiwaya"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#F9EDD2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="حفص"/>

        <Button
            android:id="@+id/qtp_btnClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✕"
            android:textColor="#FFCDD2"
            android:textSize="17sp"
            android:background="@android:color/transparent"/>

    </LinearLayout>

</RelativeLayout>
