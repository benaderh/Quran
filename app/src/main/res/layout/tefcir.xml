<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4CB"
    >

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@+id/btnAN"
            android:layout_width="110dp"
            android:layout_height="50dp"

            android:textAlignment="center"

            android:onClick="true"
            android:text="الآية التالية"

            />

        <Button
            android:id="@+id/btnP"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:textAlignment="center"
            android:onClick="true"
            android:text="+"
            />

        <Button
            android:id="@+id/btnM"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:textAlignment="center"
            android:onClick="true"
            android:text="-"
            />

        <Button
            android:id="@+id/btnAP"
            android:layout_width="110dp"
            android:layout_height="50dp"


            android:onClick="true"
            android:layout_gravity="right"
            android:text="الآية السابقة"

            />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buttons">
        <!--Scrollable content here-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView

                android:id="@+id/tv_aya"
                android:text="آية"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="#41e70e"
                android:background="#000000"
                android:textSize="30sp"
                android:paddingRight="5dp"
                />

            <TextView

                android:id="@+id/tv_sora"
                android:text="آية/سورة"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="#94ef78"
                android:background="#000000"
                android:textSize="15sp"
                android:paddingRight="25dp"
                />

            <TextView
                android:id="@+id/tv_tefcir"
                android:text="تفسير"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:paddingRight="5dp"

                />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>