<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_linearLayout_search"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText

                android:id="@+id/inputSearch"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="بـحـث ..."
                android:textSize="25dp"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp"
                android:layout_toRightOf="@+id/search_imageView_search"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@+id/search_imageView_search"
                android:src="@drawable/icon_search_black"
                android:layout_alignParentLeft="true"

                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/inputSearch" />

            <TextView


                android:id="@+id/search_textView_resultsCount"

                android:layout_width="80dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#d9270f"
                />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_linearLayout_separator"

        android:layout_width="match_parent"

        android:layout_below="@+id/search_linearLayout_search"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content" />
    <ListView
        android:id="@+id/lv_search"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"


        android:layout_below="@+id/search_linearLayout_separator"
        android:layout_alignParentBottom="true" />
</RelativeLayout>